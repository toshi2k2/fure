+"""Utilities for exporting and loading Frosting shell statistics."""
+
+from __future__ import annotations
+
+import argparse
+import logging
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Any, Dict, Mapping
+
+import numpy as np
+import torch
+
+from frosting_utils.general_utils import get_scene_name
+
+
+LOGGER = logging.getLogger(__name__)
+
+
+@dataclass(frozen=True)
+class ShellStats:
+    """Container for per-vertex shell statistics exported from Frosting."""
+
+    verts: np.ndarray
+    faces: np.ndarray
+    normals: np.ndarray
+    inner_dist: np.ndarray
+    outer_dist: np.ndarray
+    inner_points: np.ndarray
+    outer_points: np.ndarray
+    shell_width: np.ndarray
+    reliability_mask_init: np.ndarray
+
+
+def _to_numpy(value: torch.Tensor) -> np.ndarray:
+    return value.detach().cpu().numpy()
+
+
+def sanitize_vertex_normals(
+    verts: np.ndarray,
+    faces: np.ndarray,
+    normals: np.ndarray,
+    eps: float = 1e-8,
+) -> np.ndarray:
+    """Replace degenerate vertex normals with geometry-derived fallbacks."""
+    verts = np.asarray(verts, dtype=np.float32)
+    faces = np.asarray(faces, dtype=np.int32)
+    normals = np.asarray(normals, dtype=np.float32).copy()
+
+    normal_norms = np.linalg.norm(normals, axis=-1, keepdims=True)
+    valid_mask = (normal_norms[:, 0] > eps) & np.isfinite(normal_norms[:, 0])
+    if valid_mask.all():
+        return normals / np.clip(normal_norms, eps, None)
+
+    face_vertices = verts[faces]
+    face_normals = np.cross(face_vertices[:, 1] - face_vertices[:, 0], face_vertices[:, 2] - face_vertices[:, 0])
+    face_norms = np.linalg.norm(face_normals, axis=-1, keepdims=True)
+    valid_face_mask = face_norms[:, 0] > eps
+    face_normals[valid_face_mask] /= face_norms[valid_face_mask]
+    face_normals[~valid_face_mask] = 0.0
+
+    accumulated = np.zeros_like(normals, dtype=np.float32)
+    for corner in range(3):
+        np.add.at(accumulated, faces[:, corner], face_normals)
+
+    accumulated_norms = np.linalg.norm(accumulated, axis=-1, keepdims=True)
+    accumulated_valid = accumulated_norms[:, 0] > eps
+    accumulated[accumulated_valid] /= accumulated_norms[accumulated_valid]
+
+    repaired = normals.copy()
+    repaired[~valid_mask & accumulated_valid] = accumulated[~valid_mask & accumulated_valid]
+
+    repaired_norms = np.linalg.norm(repaired, axis=-1, keepdims=True)
+    repaired_valid = (repaired_norms[:, 0] > eps) & np.isfinite(repaired_norms[:, 0])
+    if not repaired_valid.all():
+        valid_indices = np.flatnonzero(repaired_valid)
+        if len(valid_indices) == 0:
+            raise ValueError("Could not derive any valid vertex normals from the shell mesh.")
+        missing_indices = np.flatnonzero(~repaired_valid)
+        valid_points = verts[valid_indices]
+        for missing_index in missing_indices:
+            nearest_index = valid_indices[np.argmin(np.linalg.norm(valid_points - verts[missing_index], axis=1))]
+            repaired[missing_index] = repaired[nearest_index]
+        repaired_norms = np.linalg.norm(repaired, axis=-1, keepdims=True)
+
+    return repaired / np.clip(repaired_norms, eps, None)
+
+
+def compute_initial_reliability_mask(shell_width: np.ndarray, max_percentile: float = 97.5) -> np.ndarray:
+    """Build a simple initial reliability mask from shell thickness outliers."""
+    abs_width = np.abs(np.asarray(shell_width, dtype=np.float32))
+    width_threshold = np.quantile(abs_width, max_percentile / 100.0)
+    return abs_width <= width_threshold
+
+
+def build_shell_stats_from_frosting(frosting: Any) -> ShellStats:
+    """Extract shell statistics from an in-memory Frosting model."""
+    with torch.no_grad():
+        verts = _to_numpy(frosting.shell_base.verts_list()[0])
+        faces = _to_numpy(frosting.shell_base.faces_list()[0])
+        normals = sanitize_vertex_normals(
+            verts=verts,
+            faces=faces,
+            normals=_to_numpy(frosting.shell_base_normals),
+        )
+        inner_dist = _to_numpy(frosting._inner_dist)
+        outer_dist = _to_numpy(frosting._outer_dist)
+        inner_points = verts + inner_dist[:, None] * normals
+        outer_points = verts + outer_dist[:, None] * normals
+
+    shell_width = np.abs(outer_dist - inner_dist)
+    reliability_mask_init = compute_initial_reliability_mask(shell_width)
+    return ShellStats(
+        verts=verts.astype(np.float32),
+        faces=faces.astype(np.int32),
+        normals=normals.astype(np.float32),
+        inner_dist=inner_dist.astype(np.float32),
+        outer_dist=outer_dist.astype(np.float32),
+        inner_points=inner_points.astype(np.float32),
+        outer_points=outer_points.astype(np.float32),
+        shell_width=shell_width.astype(np.float32),
+        reliability_mask_init=reliability_mask_init.astype(bool),
+    )
+
+
+def repair_shell_stats(shell_stats: ShellStats) -> ShellStats:
+    """Sanitize a previously exported shell-stat bundle in memory."""
+    normals = sanitize_vertex_normals(shell_stats.verts, shell_stats.faces, shell_stats.normals)
+    inner_points = shell_stats.verts + shell_stats.inner_dist[:, None] * normals
+    outer_points = shell_stats.verts + shell_stats.outer_dist[:, None] * normals
+    shell_width = np.abs(shell_stats.outer_dist - shell_stats.inner_dist).astype(np.float32)
+    return ShellStats(
+        verts=shell_stats.verts.astype(np.float32),
+        faces=shell_stats.faces.astype(np.int32),
+        normals=normals.astype(np.float32),
+        inner_dist=shell_stats.inner_dist.astype(np.float32),
+        outer_dist=shell_stats.outer_dist.astype(np.float32),
+        inner_points=inner_points.astype(np.float32),
+        outer_points=outer_points.astype(np.float32),
+        shell_width=shell_width,
+        reliability_mask_init=compute_initial_reliability_mask(shell_width).astype(bool),
+    )
+
+
+def shell_output_dir(scene_name: str, output_root: str | Path = "output/refined_frosting_shell") -> Path:
+    """Return the output directory used for shell exports."""
+    return Path(output_root) / scene_name
+
+
+def write_shell_debug_ply(shell_stats: ShellStats, output_path: str | Path) -> Path:
+    """Write a colored point cloud containing base, inner, and outer shell samples."""
+    import open3d as o3d
+
+    output_path = Path(output_path)
+    output_path.parent.mkdir(parents=True, exist_ok=True)
+    base_color = np.tile(np.array([[0.65, 0.65, 0.65]], dtype=np.float64), (len(shell_stats.verts), 1))
+    inner_color = np.tile(np.array([[0.90, 0.25, 0.25]], dtype=np.float64), (len(shell_stats.inner_points), 1))
+    outer_color = np.tile(np.array([[0.20, 0.45, 0.90]], dtype=np.float64), (len(shell_stats.outer_points), 1))
+    points = np.concatenate([shell_stats.verts, shell_stats.inner_points, shell_stats.outer_points], axis=0)
+    colors = np.concatenate([base_color, inner_color, outer_color], axis=0)
+    point_cloud = o3d.geometry.PointCloud()
+    point_cloud.points = o3d.utility.Vector3dVector(points.astype(np.float64))
+    point_cloud.colors = o3d.utility.Vector3dVector(colors)
+    o3d.io.write_point_cloud(str(output_path), point_cloud)
+    return output_path
+
+
+def save_shell_stats(shell_stats: ShellStats, output_dir: str | Path) -> Path:
+    """Persist shell statistics to the canonical npz file and debug point cloud."""
+    output_dir = Path(output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    shell_stats_path = output_dir / "shell_stats.npz"
+    np.savez_compressed(
+        shell_stats_path,
+        verts=shell_stats.verts,
+        faces=shell_stats.faces,
+        normals=shell_stats.normals,
+        inner_dist=shell_stats.inner_dist,
+        outer_dist=shell_stats.outer_dist,
+        inner_points=shell_stats.inner_points,
+        outer_points=shell_stats.outer_points,
+        shell_width=shell_stats.shell_width,
+        reliability_mask_init=shell_stats.reliability_mask_init,
+    )
+    write_shell_debug_ply(shell_stats, output_dir / "shell_debug.ply")
+    return shell_stats_path
+
+
+def export_shell_stats_from_frosting(
+    frosting: Any,
+    scene_name: str,
+    output_root: str | Path = "output/refined_frosting_shell",
+) -> Path:
+    """Export the shell statistics consumed by FurE preprocessing."""
+    shell_stats = build_shell_stats_from_frosting(frosting)
+    return save_shell_stats(shell_stats, shell_output_dir(scene_name, output_root=output_root))
+
+
+def load_shell_stats(shell_stats_path: str | Path) -> ShellStats:
+    """Load shell statistics from disk."""
+    data: Mapping[str, np.ndarray] = np.load(shell_stats_path)
+    return ShellStats(
+        verts=np.asarray(data["verts"], dtype=np.float32),
+        faces=np.asarray(data["faces"], dtype=np.int32),
+        normals=np.asarray(data["normals"], dtype=np.float32),
+        inner_dist=np.asarray(data["inner_dist"], dtype=np.float32),
+        outer_dist=np.asarray(data["outer_dist"], dtype=np.float32),
+        inner_points=np.asarray(data["inner_points"], dtype=np.float32),
+        outer_points=np.asarray(data["outer_points"], dtype=np.float32),
+        shell_width=np.asarray(data["shell_width"], dtype=np.float32),
+        reliability_mask_init=np.asarray(data["reliability_mask_init"], dtype=bool),
+    )
+
+
+def repair_shell_stats_file(shell_stats_path: str | Path, output_path: str | Path | None = None) -> Path:
+    """Repair an on-disk shell-stat bundle and write the sanitized result."""
+    shell_stats_path = Path(shell_stats_path)
+    shell_stats = repair_shell_stats(load_shell_stats(shell_stats_path))
+    if output_path is None:
+        output_dir = shell_stats_path.parent
+    else:
+        output_path = Path(output_path)
+        output_dir = output_path.parent if output_path.suffix else output_path
+    return save_shell_stats(shell_stats, output_dir)
+
+
+def find_latest_checkpoint(frosting_root: str | Path) -> Path:
+    """Locate the latest Frosting checkpoint under a training output directory."""
+    frosting_root = Path(frosting_root)
+    if frosting_root.is_file():
+        return frosting_root
+    checkpoints = sorted(frosting_root.rglob("*.pt"))
+    if not checkpoints:
+        raise FileNotFoundError(f"No Frosting checkpoints found under {frosting_root}")
+    return max(checkpoints, key=lambda path: (path.stat().st_mtime, int(path.stem) if path.stem.isdigit() else -1))
+
+
+def export_shell_stats_from_checkpoint(
+    checkpoint_path: str | Path,
+    scene_name: str,
+    output_root: str | Path = "output/refined_frosting_shell",
+    device: str = "cpu",
+) -> Path:
+    """Load a Frosting checkpoint and export shell statistics."""
+    from frosting_scene.frosting_model import load_frosting_model
+
+    frosting = load_frosting_model(str(checkpoint_path), device=torch.device(device))
+    return export_shell_stats_from_frosting(frosting=frosting, scene_name=scene_name, output_root=output_root)
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="Export Frosting shell statistics for the animal skin pipeline.")
+    parser.add_argument("--scene_path", type=str, default=None, help="Scene path used to derive the output scene name.")
+    parser.add_argument("--scene_name", type=str, default=None, help="Override the output scene name.")
+    parser.add_argument("--frosting_root", type=str, default=None, help="Frosting checkpoint file or output directory.")
+    parser.add_argument("--shell_stats_path", type=str, default=None, help="Repair an existing shell_stats.npz instead of loading a Frosting checkpoint.")
+    parser.add_argument(
+        "--output_root",
+        type=str,
+        default="output/refined_frosting_shell",
+        help="Root directory for shell statistic exports.",
+    )
+    parser.add_argument("--device", type=str, default="cpu", help="Torch device used to load the checkpoint.")
+    return parser.parse_args()
+
+
+def main() -> None:
+    logging.basicConfig(level=logging.INFO, format="[%(levelname)s] %(message)s")
+    args = parse_args()
+    if args.shell_stats_path is not None:
+        repaired_path = repair_shell_stats_file(args.shell_stats_path)
+        LOGGER.info("Repaired shell statistics saved to %s", repaired_path)
+        return
+    if args.frosting_root is None:
+        raise ValueError("Either --frosting_root or --shell_stats_path must be provided.")
+    scene_name = args.scene_name
+    if scene_name is None:
+        if args.scene_path is not None:
+            scene_name = get_scene_name(args.scene_path)
+        else:
+            scene_name = get_scene_name(args.frosting_root)
+    checkpoint_path = find_latest_checkpoint(args.frosting_root)
+    shell_stats_path = export_shell_stats_from_checkpoint(
+        checkpoint_path=checkpoint_path,
+        scene_name=scene_name,
+        output_root=args.output_root,
+        device=args.device,
+    )
+    LOGGER.info("Shell statistics saved to %s", shell_stats_path)
+
+
+if __name__ == "__main__":
+    main()
