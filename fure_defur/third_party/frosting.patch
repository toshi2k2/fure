+def deterministic_poisson_subsample_indices(
+    count: int,
+    max_points: int,
+    *,
+    device: Union[torch.device, str],
+    seed: int = 20260504,
+) -> torch.Tensor:
+    """Return deterministic random indices for bounded Poisson reconstruction.
+
+    A strided/linspace sample can preserve ordering artifacts from the surface
+    point generator and show up as regular holes in the reconstructed mesh.
+    Random sampling avoids that aliasing while staying reproducible.
+    """
+
+    if max_points <= 0 or count <= max_points:
+        return torch.arange(count, device=device, dtype=torch.long)
+    generator = torch.Generator(device="cpu")
+    generator.manual_seed(seed)
+    indices = torch.randperm(count, generator=generator)[:max_points].sort().values
+    return indices.to(device=device)
+
